__pycache__/
*.pyc
.venv/

# Query sets and baselines measured against the real vault. The queries name real
# accounts, policies and registrations, so they stay local by construction -
# tests/relevance/eval.py takes --queries and --baseline for exactly this reason.
tests/relevance/private*.json
!tests/relevance/private.example.json

# Planning and design notes - the comparison, the plan and its decision records.
# Kept alongside the code rather than published with it.
docs/

# Written into the image by the Dockerfile so /readyz can name the build. A
# checkout reads .git instead, so a committed one could only ever be stale.
REVISION
